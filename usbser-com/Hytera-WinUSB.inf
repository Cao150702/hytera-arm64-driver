[Version]
Signature = "$Windows NT$"
Class = USBDevice
ClassGUID = {88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider = %ProviderName%
DriverVer = 09/04/2012,1.0.0.0
CatalogFile = Hytera-WinUSB.cat

[Manufacturer]
%ProviderName% = DeviceList, NTarm64

[DeviceList.NTarm64]
%DeviceName% = USB_Install, USB\VID_238B&PID_0A11
%DeviceName% = USB_Install, USB\VID_238B&PID_0A11&REV_0000

[USB_Install]
Include = winusb.inf
Needs   = WINUSB.NT

[USB_Install.Services]
Include = winusb.inf
Needs   = WINUSB.NT.Services

[USB_Install.HW]
AddReg = Dev_AddReg

[Dev_AddReg]
HKR,,DeviceInterfaceGUIDs,0x10000,"{D6B3F5C2-8A1E-4C2D-9B7A-3E5F1A2C4D6B}"

[Strings]
ProviderName = "Hytera"
DeviceName = "Hytera DMR Radio (WinUSB)"
